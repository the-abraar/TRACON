{
  "name": "tracon-atc",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run build -w tracon-ui && node packages/tracon-cli/bin/tracon.js start",
    "dev:ui": "npm run dev -w tracon-ui",
    "test": "node --test 'packages/avalokita-engine/test/*.test.ts' 'packages/tracon-ui/test/*.test.ts' 'packages/tracon-cli/test/*.test.js'",
    "lint": "tsc --noEmit -p packages/avalokita-engine && tsc --noEmit -p packages/tracon-ui"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
