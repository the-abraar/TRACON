<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts the engine at login and restarts it if it dies. Install: see README "Start at login". -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.blackbird.tracon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>packages/tracon-cli/bin/tracon.js</string>
    <string>start</string>
    <string>--no-open</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/blackbird/Everything/dev/products/TRACON</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/blackbird/Library/Logs/tracon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/blackbird/Library/Logs/tracon.log</string>
</dict>
</plist>
